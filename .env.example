# Azure Speech resource (https://portal.azure.com — Speech service, Keys and Endpoint)
SUBSCRIPTION_KEY=your-azure-speech-key
SERVICE_REGION=eastus
# Optional: custom endpoint, leave empty to use the regional default
SERVICE_ENDPOINT=

# Telegram bot (https://t.me/BotFather). Leave empty to run the web server
# without Telegram wiring (dev mode only).
TELEGRAM_BOT_TOKEN=
# Random string sent with every webhook update so impostors are rejected.
TELEGRAM_WEBHOOK_SECRET=

# Web server. MINIAPP_PUBLIC_URL (an HTTPS URL such as a tailscale funnel
# or cloudflared tunnel) triggers set_webhook on startup.
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8000
MINIAPP_PUBLIC_URL=

# Dev mode: a plain browser talks to the API as this fixed user. The dev
# id must still be allowlisted below, or requests are rejected.
MINIAPP_DEV_MODE=
MINIAPP_DEV_USER_ID=900000001
MINIAPP_DEV_USER_NAME=Dev Browser User

# Comma-separated Telegram IDs allowed to use the app (send /id to the bot
# to find yours). Empty → nobody is allowed.
ALLOWED_TELEGRAM_IDS=

# Comma-separated Telegram IDs who administer access (approve/block
# others). Seeded once as active admins when the database upgrades; the
# database is the source of truth afterwards. Empty is allowed but
# warns at startup, because nobody could approve anyone.
ADMIN_TELEGRAM_IDS=
