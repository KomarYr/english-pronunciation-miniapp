# Azure Speech resource (https://portal.azure.com — Speech service, Keys and Endpoint)
SUBSCRIPTION_KEY=your-azure-speech-key
SERVICE_REGION=eastus
# Optional: custom endpoint, leave empty to use the regional default
SERVICE_ENDPOINT=

# Telegram bot (https://t.me/BotFather). Leave empty to run the web server
# without Telegram wiring (dev mode only).
TELEGRAM_BOT_TOKEN=
# Random string sent with every webhook update so impostors are rejected.
TELEGRAM_WEBHOOK_SECRET=

# Web server. MINIAPP_PUBLIC_URL (an HTTPS URL such as a tailscale funnel
# or cloudflared tunnel) triggers set_webhook on startup.
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8000
MINIAPP_PUBLIC_URL=

# Dev mode: a plain browser talks to the API as this fixed user. The dev
# user must still hold an active access entry like anyone else — arrange
# it with `uv run azure-mini-app-dev seed` (works on fresh and existing
# databases).
MINIAPP_DEV_MODE=
MINIAPP_DEV_USER_ID=900000001
MINIAPP_DEV_USER_NAME=Dev Browser User

# The access bootstrap: comma-separated Telegram IDs seeded as `active`
# ADMINS once, at the first run (find yours via /id). The database is the
# live gate afterwards — everyone else gets in by requesting access and
# being /approved by an admin. Empty is allowed but warns at startup,
# because nobody could approve anyone.
ADMIN_TELEGRAM_IDS=

# Legacy migration seed: comma-separated Telegram IDs seeded as `active`
# (non-admin) entries ONCE, at the first run — for upgrading a pre-v2
# database with an existing allowlist. Leave empty for new setups; if
# set, it warns at startup and can be removed after the first start.
ALLOWED_TELEGRAM_IDS=
